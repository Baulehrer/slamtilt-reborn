#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ ! -x "$project_dir/build/native/slamview" ]]; then
    echo 'Build first: cmake -S . -B build/native && cmake --build build/native' >&2
    exit 1
fi
exec "$project_dir/build/native/slamview" "$@"
