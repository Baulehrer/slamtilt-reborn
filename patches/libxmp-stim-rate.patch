+/* Transfer live Retail STIM voices only between compatible, freshly loaded
+ * sample banks. Validate everything before mutating the destination. */
+int xmp_slam_transfer(xmp_context from, xmp_context to)
+{
+	struct context_data *a = (struct context_data *)from;
+	struct context_data *b = (struct context_data *)to;
+	struct player_data *x, *y;
+	int i;
+	if (!a || !b || a == b) return -1;
+	x = &a->p; y = &b->p;
+	if (a->state < XMP_STATE_PLAYING || b->state < XMP_STATE_PLAYING ||
+	    strcmp(a->m.mod.type, "Slamtilt") || strcmp(b->m.mod.type, "Slamtilt") ||
+	    a->m.mod.chn != 4 || b->m.mod.chn != 4 ||
+	    a->m.mod.smp != b->m.mod.smp || a->m.mod.ins != b->m.mod.ins ||
+	    a->m.mod.ins != a->m.mod.smp || x->virt.maxvoc != y->virt.maxvoc ||
+	    x->virt.virt_channels != y->virt.virt_channels || x->virt.num_tracks != y->virt.num_tracks ||
+	    !x->xc_data || !y->xc_data || !x->virt.voice_array || !y->virt.voice_array ||
+	    !x->virt.virt_channel || !y->virt.virt_channel || y->virt.virt_used != 0 ||
+	    y->buffer_data.in_size != 0 || a->s.freq != b->s.freq || a->s.mix != b->s.mix ||
+	    a->s.interp != b->s.interp || a->s.format != b->s.format || a->s.amplify != b->s.amplify ||
+	    x->master_vol != 66 || y->master_vol != 66 || a->s.mix != 0 ||
+	    a->s.interp != XMP_INTERP_NEAREST || (a->s.format & XMP_FORMAT_MONO) ||
+	    (x->flags & XMP_FLAGS_A500) || (y->flags & XMP_FLAGS_A500)) return -1;
+	for (i = 0; i < a->m.mod.smp; ++i) {
+		struct xmp_sample *s = &a->m.mod.xxs[i], *t = &b->m.mod.xxs[i];
+		struct xmp_instrument *si = &a->m.mod.xxi[i], *ti = &b->m.mod.xxi[i];
+		if (s->len < 0 || s->len != t->len || s->lps != t->lps || s->lpe != t->lpe ||
+		    s->flg != t->flg || (s->flg & (XMP_SAMPLE_16BIT | XMP_SAMPLE_STEREO | XMP_SAMPLE_SYNTH)) ||
+		    ((s->data == NULL) != (t->data == NULL)) ||
+		    (s->data && memcmp(s->data, t->data, (size_t)s->len)) ||
+		    si->nsm != ti->nsm || ((si->sub == NULL) != (ti->sub == NULL)) ||
+		    (si->sub && (si->sub->vol != ti->sub->vol || si->sub->fin != ti->sub->fin ||
+		                 si->sub->xpo != ti->sub->xpo || si->sub->pan != ti->sub->pan ||
+		                 si->sub->sid != ti->sub->sid)) ||
+		    a->m.xtra[i].c5spd != b->m.xtra[i].c5spd) return -2;
+	}
+	for (i = 0; i < x->virt.maxvoc; ++i) {
+		struct mixer_voice *v = &x->virt.voice_array[i];
+		if (y->virt.voice_array[i].chn >= 0) return -1;
+		if (v->chn >= 0 && (v->smp < 0 || v->smp >= a->m.mod.smp ||
+		    (v->sptr && v->sptr != a->m.mod.xxs[v->smp].data))) return -3;
+	}
+	for (i = 0; i < x->virt.virt_channels; ++i) {
+#ifndef LIBXMP_CORE_PLAYER
+		void *extra = y->xc_data[i].extra;
+#endif
+		y->xc_data[i] = x->xc_data[i];
+#ifndef LIBXMP_CORE_PLAYER
+		y->xc_data[i].extra = extra;
+#endif
+		y->virt.virt_channel[i] = x->virt.virt_channel[i];
+	}
+	y->virt.virt_used = x->virt.virt_used;
+	for (i = 0; i < x->virt.maxvoc; ++i) {
+		struct mixer_voice *v = &x->virt.voice_array[i], *w = &y->virt.voice_array[i];
+#ifdef LIBXMP_PAULA_SIMULATOR
+		struct paula_state *paula = w->paula;
+#endif
+		*w = *v;
+#ifdef LIBXMP_PAULA_SIMULATOR
+		w->paula = paula;
+#endif
+		if (v->chn >= 0 && v->sptr) w->sptr = b->m.mod.xxs[v->smp].data;
+		else if (v->chn < 0) w->sptr = NULL;
+	}
+	return 0;
+}
+
+/* Transfer live Retail STIM voices only between compatible, freshly loaded
+ * sample banks. Validate everything before mutating the destination. */
+int xmp_slam_resume(xmp_context from, xmp_context to)
+{
+	struct context_data *a = (struct context_data *)from;
+	struct context_data *b = (struct context_data *)to;
+	struct player_data *x, *y;
+	int i;
+	if (!a || !b || a == b) return -1;
+	if (!b->p.slam_snapshot || !b->p.slam_snapshot_valid || b->p.slam_snapshot_order < 0 ||
+	    b->p.slam_snapshot_order >= b->m.mod.len) return -1;
+	x = &a->p; y = &b->p;
+	if (a->state < XMP_STATE_PLAYING || b->state < XMP_STATE_PLAYING ||
+	    strcmp(a->m.mod.type, "Slamtilt") || strcmp(b->m.mod.type, "Slamtilt") ||
+	    a->m.mod.chn != 4 || b->m.mod.chn != 4 ||
+	    a->m.mod.smp != b->m.mod.smp || a->m.mod.ins != b->m.mod.ins ||
+	    a->m.mod.ins != a->m.mod.smp || x->virt.maxvoc != y->virt.maxvoc ||
+	    x->virt.virt_channels != y->virt.virt_channels || x->virt.num_tracks != y->virt.num_tracks ||
+	    !x->xc_data || !y->xc_data || !x->virt.voice_array || !y->virt.voice_array ||
+	    !x->virt.virt_channel || !y->virt.virt_channel ||
+	    a->s.freq != b->s.freq || a->s.mix != b->s.mix ||
+	    a->s.interp != b->s.interp || a->s.format != b->s.format || a->s.amplify != b->s.amplify ||
+	    x->master_vol != 66 || y->master_vol != 66 || a->s.mix != 0 ||
+	    a->s.interp != XMP_INTERP_NEAREST || (a->s.format & XMP_FORMAT_MONO) ||
+	    (x->flags & XMP_FLAGS_A500) || (y->flags & XMP_FLAGS_A500)) return -1;
+	for (i = 0; i < a->m.mod.smp; ++i) {
+		struct xmp_sample *s = &a->m.mod.xxs[i], *t = &b->m.mod.xxs[i];
+		struct xmp_instrument *si = &a->m.mod.xxi[i], *ti = &b->m.mod.xxi[i];
+		if (s->len < 0 || s->len != t->len || s->lps != t->lps || s->lpe != t->lpe ||
+		    s->flg != t->flg || (s->flg & (XMP_SAMPLE_16BIT | XMP_SAMPLE_STEREO | XMP_SAMPLE_SYNTH)) ||
+		    ((s->data == NULL) != (t->data == NULL)) ||
+		    (s->data && memcmp(s->data, t->data, (size_t)s->len)) ||
+		    si->nsm != ti->nsm || ((si->sub == NULL) != (ti->sub == NULL)) ||
+		    (si->sub && (si->sub->vol != ti->sub->vol || si->sub->fin != ti->sub->fin ||
+		                 si->sub->xpo != ti->sub->xpo || si->sub->pan != ti->sub->pan ||
+		                 si->sub->sid != ti->sub->sid)) ||
+		    a->m.xtra[i].c5spd != b->m.xtra[i].c5spd) return -2;
+	}
+	for (i = 0; i < x->virt.maxvoc; ++i) {
+		struct mixer_voice *v = &x->virt.voice_array[i];
+
+		if (v->chn >= 0 && (v->smp < 0 || v->smp >= a->m.mod.smp ||
+		    (v->sptr && v->sptr != a->m.mod.xxs[v->smp].data))) return -3;
+	}
+	/* All validation is complete; discard stale destination output only now. */
+	if (xmp_play_buffer(to, NULL, 0, 0) != 0) return -1;
+	for (i = 0; i < x->virt.virt_channels; ++i) {
+#ifndef LIBXMP_CORE_PLAYER
+		void *extra = y->xc_data[i].extra;
+#endif
+		if (i < 4) y->xc_data[i] = y->slam_snapshot[i];
+		y->xc_data[i].period = x->xc_data[i].period;
+		y->xc_data[i].volume = x->xc_data[i].volume;
+#ifndef LIBXMP_CORE_PLAYER
+		y->xc_data[i].extra = extra;
+#endif
+		y->virt.virt_channel[i] = x->virt.virt_channel[i];
+	}
+	y->virt.virt_used = x->virt.virt_used;
+	for (i = 0; i < x->virt.maxvoc; ++i) {
+		struct mixer_voice *v = &x->virt.voice_array[i], *w = &y->virt.voice_array[i];
+#ifdef LIBXMP_PAULA_SIMULATOR
+		struct paula_state *paula = w->paula;
+#endif
+		*w = *v;
+#ifdef LIBXMP_PAULA_SIMULATOR
+		w->paula = paula;
+#endif
+		if (v->chn >= 0 && v->sptr) w->sptr = b->m.mod.xxs[v->smp].data;
+		else if (v->chn < 0) w->sptr = NULL;
+	}
+	if (xmp_set_position(to, y->slam_snapshot_order) < -1) return -1;
+	return 0;
+}
