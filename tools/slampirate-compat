#!/usr/bin/env python3
"""Reuse the exact verified Mean Debian toolchain for an offline Pirate build."""
import argparse,json,os,re,subprocess
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]
def main():
    p=argparse.ArgumentParser();p.add_argument('--output',type=Path,default=ROOT/'build/compat');p.add_argument('--release-name',default='slamtilt-pirate-bookworm');a=p.parse_args()
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*',a.release_name):p.error('Invalid release name')
    output=a.output.resolve();metadata=json.loads((ROOT/'build/compat/build.json').read_text());image=metadata['image_id']
    for dest in [output/'releases'/a.release_name,output/'releases'/(a.release_name+'.tar.gz')]:
        if dest.exists()or dest.is_symlink():p.error('Destination already exists: '+str(dest))
    subprocess.run(['docker','image','inspect',image],check=True,stdout=subprocess.DEVNULL)
    output.mkdir(parents=True,exist_ok=True)
    subprocess.run(['docker','run','--rm','--network','none','--user',f'{os.getuid()}:{os.getgid()}',
        '--mount',f'type=bind,src={ROOT},dst=/workspace,readonly','--mount',f'type=bind,src={output},dst=/output',
        '-e','SLAM_COMPAT_RELEASE_NAME='+a.release_name,image,'/bin/sh','/workspace/packaging/pirate-compat-build.sh'],check=True)
    report=dict(image_id=image,pins=metadata['pins'],program=str(output/'releases'/a.release_name),source_read_only=True,network_disabled=True,verification_pending=True)
    (output/'pirate-build.json').write_text(json.dumps(report,indent=2)+'\n');print(report['program'])
if __name__=='__main__':main()
