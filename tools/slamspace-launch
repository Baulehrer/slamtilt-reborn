#!/bin/sh
set -eu
script=$(readlink -f -- "$0")
here=$(CDPATH= cd -P "$(dirname "$script")" && pwd)
if [ -d "$here/bin" ]; then
    root=$here; executable=$root/bin/slamslice; setup=$root/bin/slamspace-setup
    importer=$root/bin/slamspace-import; recipe=$root/share/slamtilt/space-retail-startup.json
    profiles=$root/share/slamtilt/table-profiles.json
    data=${SLAM_SPACE_DATA_DIR:-$root/data}; prepared=$data/space-prepared
else
    root=$(CDPATH= cd -P "$here/.." && pwd)
    executable=$root/build/native/slamslice; setup=$root/build/native/slamspace-setup
    importer=$root/build/native/slamspace-import; recipe=$root/analysis/import/space-retail-startup.json
    profiles=$root/analysis/table-profiles.json
    data=${SLAM_SPACE_DATA_DIR:-$root/build/imported/space-retail}; prepared=${SLAM_SPACE_PREPARED:-$data/space-prepared}
fi
explicit=false; choose=false; check=false
[ -z "${SLAM_SPACE_DATA_DIR:-}" ] || explicit=true
while [ "$#" -gt 0 ]; do
    case "$1" in
        --data|--data-dir)
            [ "$#" -ge 2 ] || { echo 'Missing Space data directory.' >&2; exit 2; }
            data=$2;prepared=$data/space-prepared;explicit=true;shift 2 ;;
        --setup) choose=true;shift ;;
        --check) check=true;shift ;;
        --help|-h)
            echo 'Usage: slamspace [--data DIRECTORY] [--setup] [--check] [game options]'
            echo 'First start: choose original Retail data for native import, or existing imported data.'
            echo 'Display: --fullscreen or --windowed; Escape: options.'
            echo 'Enter: launch; Shift: flippers; Left Ctrl: loop direction; Right Ctrl: Magnasaver; Escape: options.'
            exit 0 ;;
        *) break ;;
    esac
done
if [ -d "$root/lib" ]; then LD_LIBRARY_PATH="$root/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}";export LD_LIBRARY_PATH;fi
if ! "$explicit"; then
    if saved=$("$setup" --importer "$importer" --profile "$recipe" --saved); then data=$saved;prepared=$data/space-prepared;fi
fi
if "$choose" || { ! "$explicit" && ! "$check" && [ ! -s "$data/SPACE.DAT" ]; }; then
    if selected=$("$setup" --importer "$importer" --profile "$recipe");then data=$selected;prepared=$data/space-prepared;else exit "$?";fi
fi
"$importer" --check "$data" >/dev/null || { echo 'Space data does not match the supported Retail profile.' >&2;exit 2; }
export SLAM_TABLE_PROFILES="$profiles"
if "$check";then echo "Space ready: $data";exit 0;fi
exec "$executable" space "$prepared" "$data/SPACE.DAT" "$@"
