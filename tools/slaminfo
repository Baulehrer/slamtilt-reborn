#!/usr/bin/env python3
"""Read-only Slam Tilt corpus/asset inspector. Uses the Python standard library."""
import argparse
from collections import Counter
import hashlib
import json
import math
from pathlib import Path
import struct

PROFILES = {
    '1169210c52fb4cb8785a0ef87e42bcabbc9d7b17bf9b9062f4642fb2cb69755f': ('Mean Machines', 0x1590c8),
    '6050b576678ec9b1878c203c057089b1c2499cdfd4a1ebdd7220f9d665fac7d6': ('The Pirate', 0x14605c),
    '18a308bdfa9fe141f57d4462a44dc4dd69cb32c35f9e6f83462fce770600115b': ('Ace of Space', 0x14c035),
    '0d78f5dbc069c5082cecce06f9620385288f615c03c83696483a43f272069c4d': ('Night of the Demon', 0x146830),
}

def inspect(path):
    data = path.read_bytes()
    digest = hashlib.sha256(data).hexdigest()
    count = Counter(data)
    result = dict(path=str(path), size=len(data), sha256=digest,
                  entropy_bits_per_byte=-sum((n/len(data))*math.log2(n/len(data)) for n in count.values()),
                  format='UNKNOWN', structures=[])
    if digest in PROFILES:
        name, offset = PROFILES[digest]
        result.update(format='Windows table DAT', table=name, confidence=1.0)
        result['structures'].append(dict(kind='indexed playfield', palette_offset=offset,
            pixels_offset=offset+1024, width=320, height=600, palette='00RRGGBB', stride=320))
        first = struct.unpack_from('>I', data)[0]
        offsets = struct.unpack_from('>' + 'I' * (first//4), data)
        samples = []
        for o in offsets:
            words, volume, loop_start, loop_words, reserved = struct.unpack_from('>5H', data, o)
            samples.append(dict(offset=o, data_offset=o+10, length=words*2, volume=volume,
                                loop_start_words=loop_start, loop_length_words=loop_words, reserved=reserved))
        result['structures'].append(dict(kind='sample directory', endian='big', count=len(samples),
                                         samples=samples, interpretation='PCM signedness/rate not yet verified'))
    elif data.startswith(b'SLAM') and len(data) >= 16:
        marker, unpacked, packed = struct.unpack_from('>III', data, 4)
        result.update(format='SLAM / backward StoneCracker-family payload', confidence=0.98)
        result['structures'].append(dict(kind='compression header', marker=marker,
            unpacked_size=unpacked, packed_size=packed, header_size=16,
            available_after_header=len(data)-16, note='packed length semantics require decoder; possible alignment bytes'))
    elif data.startswith(b'STTF') and len(data) >= 34:
        pointers = struct.unpack_from('>7I', data, 6)
        result.update(format='Amiga STTF table descriptor/highscores', confidence=0.99)
        result['structures'].append(dict(kind='descriptor pointers', offsets=list(pointers)))
        score = pointers[6]
        if score+70 <= len(data):
            records=[]
            for i in range(5):
                record=data[score+i*14:score+(i+1)*14]
                bcd=record[:6].hex()
                valid=all(c in '0123456789' for c in bcd)
                records.append(dict(score=int(bcd) if valid else None, valid_bcd=valid,
                    initials=record[6:9].decode('ascii',errors='replace'), trailing_hex=record[9:].hex()))
            result['structures'].append(dict(kind='highscores', offset=score, stride=14, records=records))
    elif data.startswith(b'STTL'):
        result.update(format='Amiga STTL table list', confidence=0.99)
        for o in range(4,len(data)-3,4):
            pointer=struct.unpack_from('>I',data,o)[0]
            if pointer==0xffffffff: break
            if pointer>=len(data):
                result['structures'].append(dict(kind='invalid pointer',offset=o,value=pointer));break
            result['structures'].append(dict(kind='table path',offset=pointer,
                value=data[pointer:].split(b'\0',1)[0].decode('latin1')))
    elif data.startswith(b'RNC') and len(data)>=18:
        result.update(format='RNC compressed', method=data[3],
            unpacked_size=int.from_bytes(data[4:8],'big'),packed_size=int.from_bytes(data[8:12],'big'),confidence=1.0)
    elif data.startswith(bytes.fromhex('000003f3')):
        result.update(format='Amiga HUNK executable', confidence=1.0)
    elif data.startswith(b'MZ'):
        result.update(format='DOS MZ executable; inspect PE/NE separately',confidence=1.0)
        if len(data)>=64:
            o=int.from_bytes(data[60:64],'little')
            if o+4<=len(data):result['secondary_magic']=data[o:o+4].hex()
    elif data.startswith(b'STIM'):
        result.update(format='STIM tracker module',confidence=1.0)
    if result['format'] == 'UNKNOWN' and len(data) >= 4:
        section = struct.unpack_from('>I', data)[0]
        if section + 24 <= len(data):
            pointers = struct.unpack_from('>6I', data, section)
            if (pointers[0] == 24 and pointers[1] == 0x32938
                    and section + pointers[1] + 1024 <= len(data)):
                palette = section + pointers[1]
                if not any(data[palette:palette+1024:4]):
                    result.update(format='Decoded Amiga planar table RAW', confidence=0.99)
                    result['structures'].append(dict(kind='row-interleaved planar playfield',
                        section_base=section, pixels_offset=section+24,
                        palette_offset=palette, width=320, height=600,
                        row_stride=320, plane_stride=40, planes=8,
                        palette='00RRGGBB', section_relative_offsets=list(pointers)))
    return result

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('paths',nargs='+',type=Path)
    parser.add_argument('--json',action='store_true',help='emit a JSON array')
    args=parser.parse_args()
    results=[]
    failed=False
    for path in args.paths:
        try: results.append(inspect(path))
        except (OSError,ValueError,struct.error) as e:
            results.append(dict(path=str(path),error=str(e)));failed=True
    if args.json: print(json.dumps(results,indent=2))
    else:
        for item in results:
            print(json.dumps(item,indent=2))
    return int(failed)
if __name__=='__main__':raise SystemExit(main())
